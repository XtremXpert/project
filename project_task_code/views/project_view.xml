<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="project_project_task_name_display_form_view" model="ir.ui.view">
        <field name="name">project.project.form.task.name.display</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <!-- Odoo 20 dropped the extra_settings group: the setting goes
                 next to the name given to the tasks of the project. -->
            <field name="label_tasks" position="after">
                <field name="task_name_display" widget="radio" />
            </field>
        </field>
    </record>
    <record id="project_task_code_form_view" model="ir.ui.view">
        <field name="name">project.task.code.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="task_name_display" invisible="1" />
                <field name="code" class="oe_inline" />
                <span
                    class="oe_inline"
                    invisible="task_name_display == 'code'"
                > - </span>
            </field>
            <!--
                Projects displaying the number alone hide the title, so it
                cannot be required there. The field itself is not required at
                model level for that reason.
            -->
            <field name="name" position="attributes">
                <attribute name="invisible">task_name_display == 'code'</attribute>
                <attribute name="required">task_name_display != 'code'</attribute>
            </field>
        </field>
    </record>
    <record id="project_task_code_tree_view" model="ir.ui.view">
        <field name="name">project.task.code.tree</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code" />
            </field>
        </field>
    </record>
    <!-- Odoo 20 renders kanban cards from a separate card view
         (card_id of project.view_task_kanban), where the title already sits
         on the same line: the code goes right before it. -->
    <record id="project_task_code_card_view" model="ir.ui.view">
        <field name="name">project.task.code.card</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_card" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//card/field[@name='stage_id']" position="after">
                <field name="task_name_display" />
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <span class="fw-bold fs-5 me-1 text-nowrap" name="task_code">
                    [<field name="code" />]
                </span>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">task_name_display == 'code'</attribute>
            </xpath>
        </field>
    </record>
    <record id="project_task_code_search_view" model="ir.ui.view">
        <field name="name">project.task.code.search</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', ('name', 'ilike', self),
                    ('code', 'ilike', self)]
                </attribute>
            </field>
        </field>
    </record>
</odoo>
