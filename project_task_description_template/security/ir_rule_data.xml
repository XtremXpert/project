<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Odoo 20 : ir.rule est fusionne dans ir.access (operation + domain). -->
    <record id="project_task_description_template_company_ruyle" model="ir.access">
        <field name="name">Project Task Description Template Company Rule</field>
        <field name="model_id" ref="model_project_task_description_template" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
